{
  "name": "market-monitoring",
  "displayName": "Market Monitoring",
  "description": "Monitor custom market symbols, groups, alerts, and quote changes in VS Code.",
  "version": "0.1.6",
  "publisher": "niangao",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:marketMonitoring.quotesView",
    "onCommand:marketMonitoring.refresh",
    "onCommand:marketMonitoring.importCsv",
    "onCommand:marketMonitoring.exportCsv",
    "onCommand:marketMonitoring.start",
    "onCommand:marketMonitoring.stop",
    "onCommand:marketMonitoring.openSettings"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "marketMonitoring.refresh",
        "title": "Market Monitoring: Refresh Quotes",
        "icon": "$(refresh)"
      },
      {
        "command": "marketMonitoring.importCsv",
        "title": "Market Monitoring: Import CSV",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "marketMonitoring.exportCsv",
        "title": "Market Monitoring: Export CSV",
        "icon": "$(export)"
      },
      {
        "command": "marketMonitoring.start",
        "title": "Market Monitoring: Start",
        "icon": "$(play)"
      },
      {
        "command": "marketMonitoring.stop",
        "title": "Market Monitoring: Stop",
        "icon": "$(debug-pause)"
      },
      {
        "command": "marketMonitoring.openSettings",
        "title": "Market Monitoring: Open Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "marketMonitoring",
          "title": "Market Monitoring",
          "icon": "resources/market.svg"
        }
      ]
    },
    "views": {
      "marketMonitoring": [
        {
          "id": "marketMonitoring.quotesView",
          "type": "webview",
          "name": "Market Monitoring",
          "icon": "$(graph-line)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "marketMonitoring.refresh",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.importCsv",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.exportCsv",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.openSettings",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "marketMonitoring.refresh"
        },
        {
          "command": "marketMonitoring.importCsv"
        },
        {
          "command": "marketMonitoring.exportCsv"
        },
        {
          "command": "marketMonitoring.start"
        },
        {
          "command": "marketMonitoring.stop"
        },
        {
          "command": "marketMonitoring.openSettings"
        }
      ]
    },
    "configuration": {
      "title": "Market Monitoring",
      "properties": {
        "marketMonitoring.symbols": {
          "type": "array",
          "default": [
            {
              "code": "sz300308",
              "name": "中际旭创",
              "group": "观察"
            },
            {
              "code": "sh603986",
              "name": "兆易创新",
              "group": "自选"
            }
          ],
          "markdownDescription": "Market symbols to monitor. `code` supports prefixed forms like `sh600519` and `sz159915`, or six-digit codes such as `600519`, `510300`, `000001`, `159915`.",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Market symbol code."
              },
              "name": {
                "type": "string",
                "description": "Custom display name."
              },
              "group": {
                "type": "string",
                "description": "Custom group name."
              },
              "cost": {
                "type": "number",
                "description": "Optional cost basis used to calculate net profit."
              },
              "holding": {
                "type": "number",
                "description": "Optional holding quantity used to calculate net profit."
              }
            },
            "additionalProperties": false
          }
        },
        "marketMonitoring.groups": {
          "type": "array",
          "default": [
            "自选"
          ],
          "markdownDescription": "Custom groups shown in the market monitoring view. Empty groups are kept visible so symbols can be added inside a specific group.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "marketMonitoring.refreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 120,
          "description": "Quote refresh interval in seconds."
        },
        "marketMonitoring.onlyDuringTradingTime": {
          "type": "boolean",
          "default": true,
          "description": "Refresh only during configured active market sessions. Market holidays are not automatically detected."
        },
        "marketMonitoring.showStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show a compact market summary in the VS Code status bar."
        },
        "marketMonitoring.priceDecimalPlaces": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "description": "Decimal places used for quote price display."
        },
        "marketMonitoring.compactLargeAmounts": {
          "type": "boolean",
          "default": false,
          "description": "Display values greater than 10000 using W units in group summaries and exported summary rows."
        },
        "marketMonitoring.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en-US"
          ],
          "enumDescriptions": [
            "Follow the current VS Code display language.",
            "Use Simplified Chinese.",
            "Use English."
          ],
          "description": "Display language for the Market Monitoring view."
        },
        "marketMonitoring.colorMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "redUpGreenDown",
            "greenUpRedDown"
          ],
          "enumDescriptions": [
            "Do not color price change indicators.",
            "Use red for rising values and green for falling values.",
            "Use green for rising values and red for falling values."
          ],
          "description": "Color mode for rising and falling indicators."
        },
        "marketMonitoring.rowHighlightUpPercent": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Show a subtle left row marker when quote change percentage is greater than or equal to this value. Set 0 to disable rising row markers."
        },
        "marketMonitoring.rowHighlightDownPercent": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Show a subtle left row marker when quote change percentage is less than or equal to the negative of this value. Set 0 to disable falling row markers."
        },
        "marketMonitoring.quoteColumns": {
          "type": "array",
          "default": [
            "name",
            "price",
            "changePercent"
          ],
          "markdownDescription": "Columns displayed in the quote table.",
          "items": {
            "type": "string",
            "enum": [
              "name",
              "alias",
              "code",
              "price",
              "changePercent",
              "change",
              "cost",
              "holding",
              "netProfit"
            ],
            "enumDescriptions": [
              "Name.",
              "Alias generated from name pinyin.",
              "Code.",
              "Latest price.",
              "Change percentage.",
              "Price change.",
              "Editable cost basis.",
              "Editable holding quantity.",
              "Calculated net profit."
            ]
          },
          "uniqueItems": true
        },
        "marketMonitoring.groupSummaryMetrics": {
          "type": "array",
          "default": [],
          "markdownDescription": "Metrics displayed in each group summary row. Empty hides the summary row.",
          "items": {
            "type": "string",
            "enum": [
              "totalAssets",
              "dailyProfit",
              "dailyProfitPercent"
            ],
            "enumDescriptions": [
              "Total assets from latest price multiplied by holding quantity.",
              "Today profit from price change multiplied by holding quantity.",
              "Today profit percentage based on previous close assets."
            ]
          },
          "uniqueItems": true
        },
        "marketMonitoring.sortBy": {
          "type": "string",
          "default": "configured",
          "enum": [
            "configured",
            "changePercent",
            "price",
            "name",
            "alias",
            "code"
          ],
          "enumDescriptions": [
            "Keep the order from marketMonitoring.symbols.",
            "Sort by change percentage.",
            "Sort by latest price.",
            "Sort by display name.",
            "Sort by generated pinyin alias.",
            "Sort by code."
          ],
          "description": "Sort quotes inside each group."
        },
        "marketMonitoring.sortDirection": {
          "type": "string",
          "default": "desc",
          "enum": [
            "desc",
            "asc"
          ],
          "description": "Sort direction for sortable quote fields."
        },
        "marketMonitoring.enableAlerts": {
          "type": "boolean",
          "default": true,
          "description": "Enable quote alert evaluation."
        },
        "marketMonitoring.enableAlertNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code notifications when quote alerts are newly triggered."
        },
        "marketMonitoring.alerts": {
          "type": "array",
          "default": [],
          "markdownDescription": "Alert rules. A rule can contain one or more thresholds such as `priceAbove`, `priceBelow`, `changePercentAbove`, or `changePercentBelow`.",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Market symbol code."
              },
              "name": {
                "type": "string",
                "description": "Optional display name used in alert notifications."
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable this alert rule."
              },
              "priceAbove": {
                "type": "number",
                "description": "Trigger when latest price is greater than or equal to this value."
              },
              "priceBelow": {
                "type": "number",
                "description": "Trigger when latest price is less than or equal to this value."
              },
              "changePercentAbove": {
                "type": "number",
                "description": "Trigger when change percentage is greater than or equal to this value."
              },
              "changePercentBelow": {
                "type": "number",
                "description": "Trigger when change percentage is less than or equal to this value."
              }
            },
            "additionalProperties": false
          }
        },
        "marketMonitoring.requestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 20000,
          "description": "Quote request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "dependencies": {
    "pinyin-pro": "^3.28.1"
  }
}
