{
  "name": "market-monitoring",
  "displayName": "Market Monitoring",
  "description": "Monitor custom market symbols, groups, alerts, and quote changes in VS Code.",
  "version": "0.2.7",
  "publisher": "niangao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mayhot/market-monitoring.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:marketMonitoring.quotesView",
    "onCommand:marketMonitoring.refresh",
    "onCommand:marketMonitoring.importCsv",
    "onCommand:marketMonitoring.exportCsv",
    "onCommand:marketMonitoring.start",
    "onCommand:marketMonitoring.stop",
    "onCommand:marketMonitoring.openAiAssistant",
    "onCommand:marketMonitoring.configureQuoteColumns",
    "onCommand:marketMonitoring.openSettings"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "marketMonitoring.refresh",
        "title": "Market Monitoring: Refresh Quotes",
        "icon": "$(refresh)"
      },
      {
        "command": "marketMonitoring.importCsv",
        "title": "Market Monitoring: Import CSV",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "marketMonitoring.exportCsv",
        "title": "Market Monitoring: Export CSV",
        "icon": "$(export)"
      },
      {
        "command": "marketMonitoring.start",
        "title": "Market Monitoring: Start",
        "icon": "$(play)"
      },
      {
        "command": "marketMonitoring.stop",
        "title": "Market Monitoring: Stop",
        "icon": "$(debug-pause)"
      },
      {
        "command": "marketMonitoring.openAiAssistant",
        "title": "Market Monitoring: AI Assistant",
        "icon": "$(sparkle)"
      },
      {
        "command": "marketMonitoring.configureQuoteColumns",
        "title": "Market Monitoring: Configure Quote Columns",
        "icon": "$(list-ordered)"
      },
      {
        "command": "marketMonitoring.openSettings",
        "title": "Market Monitoring: Open Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "marketMonitoring",
          "title": "Market Monitoring",
          "icon": "resources/market.svg"
        }
      ]
    },
    "views": {
      "marketMonitoring": [
        {
          "id": "marketMonitoring.quotesView",
          "type": "webview",
          "name": "Market Monitoring",
          "icon": "$(graph-line)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "marketMonitoring.refresh",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.importCsv",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.exportCsv",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.openAiAssistant",
          "when": "view == marketMonitoring.quotesView && config.marketMonitoring.ai.enabled",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.configureQuoteColumns",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        },
        {
          "command": "marketMonitoring.openSettings",
          "when": "view == marketMonitoring.quotesView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "marketMonitoring.refresh"
        },
        {
          "command": "marketMonitoring.importCsv"
        },
        {
          "command": "marketMonitoring.exportCsv"
        },
        {
          "command": "marketMonitoring.start"
        },
        {
          "command": "marketMonitoring.stop"
        },
        {
          "command": "marketMonitoring.openAiAssistant",
          "when": "config.marketMonitoring.ai.enabled"
        },
        {
          "command": "marketMonitoring.configureQuoteColumns"
        },
        {
          "command": "marketMonitoring.openSettings"
        }
      ]
    },
    "configuration": {
      "title": "Market Monitoring",
      "properties": {
        "marketMonitoring.symbols": {
          "type": "array",
          "default": [
            {
              "code": "sz300308",
              "name": "中际旭创",
              "group": "观察"
            },
            {
              "code": "sh603986",
              "name": "兆易创新",
              "group": "自选"
            }
          ],
          "markdownDescription": "Market symbols to monitor. `code` supports prefixed forms like `sh600519` and `sz159915`, or six-digit codes such as `600519`, `510300`, `000001`, `159915`.",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Market symbol code."
              },
              "name": {
                "type": "string",
                "description": "Custom display name."
              },
              "group": {
                "type": "string",
                "description": "Custom group name."
              },
              "cost": {
                "type": "number",
                "description": "Optional cost basis used to calculate net profit."
              },
              "holding": {
                "type": "number",
                "description": "Optional holding quantity used to calculate net profit."
              }
            },
            "additionalProperties": false
          }
        },
        "marketMonitoring.groups": {
          "type": "array",
          "default": [
            "自选"
          ],
          "markdownDescription": "Custom groups shown in the market monitoring view. Empty groups are kept visible so symbols can be added inside a specific group.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "marketMonitoring.refreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 120,
          "description": "Quote refresh interval in seconds."
        },
        "marketMonitoring.onlyDuringTradingTime": {
          "type": "boolean",
          "default": true,
          "description": "Refresh only during configured active market sessions. Market holidays are not automatically detected."
        },
        "marketMonitoring.showStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show a compact market summary in the VS Code status bar."
        },
        "marketMonitoring.priceDecimalPlaces": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "description": "Decimal places used for quote price display."
        },
        "marketMonitoring.compactLargeAmounts": {
          "type": "boolean",
          "default": false,
          "description": "Display values greater than 10000 using W units in group summaries and exported summary rows."
        },
        "marketMonitoring.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en-US"
          ],
          "enumDescriptions": [
            "Follow the current VS Code display language.",
            "Use Simplified Chinese.",
            "Use English."
          ],
          "description": "Display language for the Market Monitoring view."
        },
        "marketMonitoring.colorMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "redUpGreenDown",
            "greenUpRedDown"
          ],
          "enumDescriptions": [
            "Do not color price change indicators.",
            "Use red for rising values and green for falling values.",
            "Use green for rising values and red for falling values."
          ],
          "description": "Color mode for rising and falling indicators."
        },
        "marketMonitoring.rowHighlightUpPercent": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Show a subtle left row marker when quote change percentage is greater than or equal to this value. Set 0 to disable rising row markers."
        },
        "marketMonitoring.rowHighlightDownPercent": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Show a subtle left row marker when quote change percentage is less than or equal to the negative of this value. Set 0 to disable falling row markers."
        },
        "marketMonitoring.quoteColumns": {
          "type": "array",
          "default": [
            "name",
            "price",
            "changePercent"
          ],
          "markdownDescription": "Columns displayed in the quote table. The array order controls the left-to-right column order. For button-style move up/down controls, run `Market Monitoring: Configure Quote Columns`.",
          "items": {
            "type": "string",
            "enum": [
              "name",
              "alias",
              "code",
              "price",
              "changePercent",
              "change",
              "cost",
              "holding",
              "position",
              "netProfit"
            ],
            "enumDescriptions": [
              "Name.",
              "Alias generated from name pinyin.",
              "Code.",
              "Latest price.",
              "Change percentage.",
              "Price change.",
              "Editable cost basis.",
              "Editable holding quantity.",
              "Calculated position percentage within the group.",
              "Calculated net profit."
            ]
          },
          "uniqueItems": true
        },
        "marketMonitoring.groupSummaryMetrics": {
          "type": "array",
          "default": [],
          "markdownDescription": "Metrics displayed in each group summary row. Empty hides the summary row.",
          "items": {
            "type": "string",
            "enum": [
              "totalAssets",
              "dailyProfit",
              "dailyProfitPercent"
            ],
            "enumDescriptions": [
              "Total assets from latest price multiplied by holding quantity.",
              "Today profit from price change multiplied by holding quantity.",
              "Today profit percentage based on previous close assets."
            ]
          },
          "uniqueItems": true
        },
        "marketMonitoring.sortBy": {
          "type": "string",
          "default": "configured",
          "enum": [
            "configured",
            "changePercent",
            "price",
            "name",
            "alias",
            "code"
          ],
          "enumDescriptions": [
            "Keep the order from marketMonitoring.symbols.",
            "Sort by change percentage.",
            "Sort by latest price.",
            "Sort by display name.",
            "Sort by generated pinyin alias.",
            "Sort by code."
          ],
          "description": "Sort quotes inside each group."
        },
        "marketMonitoring.sortDirection": {
          "type": "string",
          "default": "desc",
          "enum": [
            "desc",
            "asc"
          ],
          "description": "Sort direction for sortable quote fields."
        },
        "marketMonitoring.enableAlerts": {
          "type": "boolean",
          "default": true,
          "description": "Enable quote alert evaluation."
        },
        "marketMonitoring.enableAlertNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show VS Code notifications when quote alerts are newly triggered."
        },
        "marketMonitoring.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show and enable the AI assistant entry for natural-language group and symbol management."
        },
        "marketMonitoring.ai.provider": {
          "type": "string",
          "default": "disabled",
          "enum": [
            "disabled",
            "openai",
            "azureOpenAI",
            "anthropic",
            "gemini",
            "deepseek",
            "openrouter",
            "ollama",
            "lmStudio",
            "customOpenAICompatible"
          ],
          "enumDescriptions": [
            "Disable AI assistant.",
            "OpenAI Chat Completions API.",
            "Azure OpenAI Chat Completions API.",
            "Anthropic Messages API.",
            "Google Gemini generateContent API.",
            "DeepSeek OpenAI-compatible API.",
            "OpenRouter OpenAI-compatible API.",
            "Local Ollama OpenAI-compatible API.",
            "Local LM Studio OpenAI-compatible API.",
            "Any OpenAI-compatible /chat/completions endpoint."
          ],
          "markdownDescription": "AI provider used by the natural-language group and symbol manager."
        },
        "marketMonitoring.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "AI model name. Examples: `gpt-4.1-mini`, `claude-3-5-sonnet-latest`, `gemini-1.5-flash`, `deepseek-chat`, `openai/gpt-4o-mini`, `llama3.1`."
        },
        "marketMonitoring.ai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API key for the selected AI provider. Leave empty for local providers such as Ollama or LM Studio."
        },
        "marketMonitoring.ai.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional API base URL. For OpenAI-compatible providers this should be the API root, for example `https://api.openai.com/v1` or `http://localhost:11434/v1`."
        },
        "marketMonitoring.ai.azureApiVersion": {
          "type": "string",
          "default": "2024-06-01",
          "markdownDescription": "Azure OpenAI API version. `marketMonitoring.ai.model` is treated as the Azure deployment name."
        },
        "marketMonitoring.ai.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "AI assistant sampling temperature."
        },
        "marketMonitoring.ai.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "AI request timeout in milliseconds."
        },
        "marketMonitoring.alerts": {
          "type": "array",
          "default": [],
          "markdownDescription": "Alert rules. A rule can contain one or more thresholds such as `priceAbove`, `priceBelow`, `changePercentAbove`, or `changePercentBelow`.",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Market symbol code."
              },
              "name": {
                "type": "string",
                "description": "Optional display name used in alert notifications."
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable this alert rule."
              },
              "priceAbove": {
                "type": "number",
                "description": "Trigger when latest price is greater than or equal to this value."
              },
              "priceBelow": {
                "type": "number",
                "description": "Trigger when latest price is less than or equal to this value."
              },
              "changePercentAbove": {
                "type": "number",
                "description": "Trigger when change percentage is greater than or equal to this value."
              },
              "changePercentBelow": {
                "type": "number",
                "description": "Trigger when change percentage is less than or equal to this value."
              },
              "movingAverageBelow": {
                "type": "boolean",
                "default": true,
                "description": "Trigger when latest price is less than the configured N-day moving average windows. Enabled by default for each alert rule; set false to disable."
              },
              "movingAverageDays": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 250
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 250
                    }
                  }
                ],
                "default": [
                  5,
                  10,
                  20,
                  60
                ],
                "description": "Moving average window or windows used by movingAverageBelow. Defaults to 5, 10, 20, and 60, and is active unless movingAverageBelow is false."
              },
              "movingAverageBelowDays": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 250
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 250
                    }
                  }
                ],
                "description": "Compatibility shorthand: setting this also enables movingAverageBelow."
              },
              "bearishMovingAverage": {
                "type": "boolean",
                "default": false,
                "description": "Trigger when moving averages are in bearish order: short < mid < long."
              },
              "bearishMovingAverageShortDays": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 250,
                "description": "Short moving average window for bearishMovingAverage."
              },
              "bearishMovingAverageMidDays": {
                "type": "integer",
                "default": 20,
                "minimum": 1,
                "maximum": 250,
                "description": "Middle moving average window for bearishMovingAverage."
              },
              "bearishMovingAverageLongDays": {
                "type": "integer",
                "default": 60,
                "minimum": 1,
                "maximum": 250,
                "description": "Long moving average window for bearishMovingAverage."
              },
              "macdDeathCross": {
                "type": "boolean",
                "default": false,
                "description": "Trigger when MACD DIF crosses below DEA."
              },
              "macdBelowZeroOnly": {
                "type": "boolean",
                "default": false,
                "description": "Only trigger MACD death-cross alerts when both DIF and DEA are below zero."
              },
              "volumeDrop": {
                "type": "boolean",
                "default": false,
                "description": "Trigger on price drop with current daily volume above the configured average-volume multiplier."
              },
              "volumeDropPercent": {
                "type": "number",
                "default": 2,
                "minimum": 0,
                "description": "Minimum negative change percentage for volumeDrop."
              },
              "volumeDropAverageDays": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 250,
                "description": "Average-volume window for volumeDrop."
              },
              "volumeDropMultiplier": {
                "type": "number",
                "default": 1.5,
                "minimum": 0,
                "description": "Current volume must be at least this many times the average volume for volumeDrop."
              },
              "reboundLowVolume": {
                "type": "boolean",
                "default": false,
                "description": "Trigger when price rebounds while current daily volume is below the configured average-volume ratio."
              },
              "reboundRisePercent": {
                "type": "number",
                "default": 0,
                "minimum": 0,
                "description": "Minimum positive change percentage for reboundLowVolume."
              },
              "reboundLowVolumeAverageDays": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 250,
                "description": "Average-volume window for reboundLowVolume."
              },
              "reboundLowVolumeRatio": {
                "type": "number",
                "default": 0.8,
                "minimum": 0,
                "description": "Current volume must be less than or equal to this ratio of average volume for reboundLowVolume."
              },
              "lowBreak": {
                "type": "boolean",
                "default": false,
                "description": "Trigger when latest price breaks below the lowest low of the configured recent window."
              },
              "lowBreakDays": {
                "type": "integer",
                "default": 20,
                "minimum": 1,
                "maximum": 250,
                "description": "Lookback window for lowBreak. Setting this also enables lowBreak."
              },
              "rsiWeak": {
                "type": "boolean",
                "default": false,
                "description": "Trigger when RSI is below the configured threshold."
              },
              "rsiDays": {
                "type": "integer",
                "default": 14,
                "minimum": 1,
                "maximum": 250,
                "description": "RSI window for rsiWeak."
              },
              "rsiBelow": {
                "type": "number",
                "default": 50,
                "minimum": 0,
                "maximum": 100,
                "description": "RSI threshold for rsiWeak."
              },
              "bollingerBelow": {
                "type": [
                  "boolean",
                  "string"
                ],
                "default": false,
                "enum": [
                  false,
                  true,
                  "middle",
                  "lower"
                ],
                "description": "Trigger when latest price is below Bollinger middle or lower band. true means middle."
              },
              "bollingerDays": {
                "type": "integer",
                "default": 20,
                "minimum": 1,
                "maximum": 250,
                "description": "Bollinger band window."
              },
              "bollingerStdDev": {
                "type": "number",
                "default": 2,
                "minimum": 0,
                "description": "Bollinger band standard-deviation multiplier."
              },
              "intradayHighPullback": {
                "type": "boolean",
                "default": false,
                "description": "Trigger when the symbol's high rises above today's open, change percentage turns negative, and price has fallen from today's high by more than the configured percentage. After close, the daily K-line close is used."
              },
              "intradayHighPullbackPercent": {
                "type": "number",
                "default": 2,
                "minimum": 0,
                "description": "Minimum pullback percentage from today's high for intradayHighPullback."
              },
              "intradayDowntrendConfirmTicks": {
                "type": "integer",
                "default": 3,
                "minimum": 1,
                "maximum": 10,
                "description": "Number of consecutive refreshes required to confirm an intraday downtrend."
              },
              "intradayDowntrendSlopePoints": {
                "type": "integer",
                "default": 5,
                "minimum": 2,
                "maximum": 20,
                "description": "Number of recent refresh prices used to confirm a negative intraday slope."
              },
              "intradayVwapBelow": {
                "type": "boolean",
                "default": true,
                "description": "Require price to be below intraday VWAP when VWAP is available."
              }
            },
            "additionalProperties": false
          }
        },
        "marketMonitoring.requestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 20000,
          "description": "Quote request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js",
    "package": "node scripts/package-release.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "dependencies": {
    "pinyin-pro": "^3.28.1"
  }
}
